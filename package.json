{
  "name": "rise-and-reel",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-local desktop Solo Fishing game.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huggon1/rise-and-reel.git"
  },
  "homepage": "https://riseandreel.huggon1.com/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm test && npm run build && wrangler deploy",
    "deploy:cloudflare:dry-run": "npm test && npm run build && wrangler deploy --dry-run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "npm test && npm run test:e2e && npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "^4.118.0"
  }
}
