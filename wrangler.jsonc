{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rise-and-reel",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "riseandreel.huggon1.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
